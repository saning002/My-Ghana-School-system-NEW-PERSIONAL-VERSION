# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit .env to version control.

# Django core
SECRET_KEY=your-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (leave blank to use SQLite for local dev)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Portal URLs — point these at your Laravel school management system
PORTAL_URL=https://yourdomain.com/admin/dashboard
STUDENT_PORTAL_URL=https://yourdomain.com/portal/login
TEACHER_PORTAL_URL=https://yourdomain.com/lecturer/login

# Email (optional — for contact form notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
