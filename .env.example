APP_NAME="Kingdom Ministerial University College"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Public base URL. On Render you can omit this — config falls back to RENDER_EXTERNAL_URL.
APP_URL=https://your-app.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL (provided by Render — set via environment variables)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kmc_college
DB_USERNAME=kmc_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@kmc.edu"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudinary — cloud storage for student photos (survives deploys on free Render plan)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Initial Admin Provisioning ────────────────────────────────────────────────
# Set these ONCE on your first deployment to a new database.
# After logging in, change your credentials from the app — these env vars are
# ignored after the accounts are created (seeder is idempotent).
# NEVER commit real credentials here — set them directly in Render's dashboard.
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ── Africa's Talking (SMS — Ghana) ────────────────────────────────────────
# Sign up at https://africastalking.com — use sandbox for testing
# AT_USERNAME=sandbox  (for testing) or your actual username (for live)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=          # Your registered alphanumeric sender ID (optional)

# ── Twilio (WhatsApp) ──────────────────────────────────────────────────────
# Sign up at https://twilio.com — enable WhatsApp sandbox for testing
# WhatsApp sandbox from number: whatsapp:+14155238886
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886   # Twilio sandbox number (change for live)

# ── Paystack Payment Gateway ──────────────────────────────────────────────────
# Get your keys from https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* / pk_test_* for testing, sk_live_* / pk_live_* for production
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PAYMENT_URL=https://api.paystack.co

# ── Owner platform settings ───────────────────────────────────────────────────
# Your platform domain — used to build school login URLs
APP_DOMAIN=kmc-college-v136.onrender.com